server {
    listen 80;
    server_name ${VMQ_DOMAIN};
    access_log off;

    location = /.well-known/acme-ready {
        return 200;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }

    location / {
        return 308 https://${VMQ_DOMAIN}$request_uri;
    }
}
